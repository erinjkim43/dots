# Font settings
font-family = Liga SFMono Nerd Font
font-size = 19

# Window settings
window-padding-x = 10
window-padding-y = 5,0
window-padding-balance = true 
window-save-state = always
window-colorspace = "display-p3"

background-opacity = 0.95
background-blur = 20

# Hide title bar
macos-titlebar-proxy-icon = hidden
title = " "
macos-titlebar-style=transparent

# Misc
copy-on-select = clipboard
shell-integration-features = no-cursor,sudo,no-title
cursor-style = block
adjust-cell-height = 35%
mouse-hide-while-typing = true

link-url = false
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
background = #222436
foreground = #c8d3f5
selection-background = #2d3f76
selection-foreground = #c8d3f5
cursor-color = #c8d3f5
cursor-text = #222436
palette = 0=#1b1d2b
palette = 1=#ff757f
palette = 2=#c3e88d
palette = 3=#ffc777
palette = 4=#82aaff
palette = 5=#c099ff
palette = 6=#86e1fc
palette = 7=#828bb8
palette = 8=#444a73
palette = 9=#ff757f
palette = 10=#c3e88d
palette = 11=#ffc777
palette = 12=#82aaff
palette = 13=#c099ff
palette = 14=#86e1fc
palette = 15=#c8d3f5
mouse-hide-while-typing = true

# Hand cmd+t and cmd+1..9 to the running program (herdr) instead of driving
# Ghostty's own tabs. Herdr binds them to new_tab / switch_tab.
keybind = super+t=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
# Ghostty binds each digit twice: a logical `super+N` and a physical
# `super+digit_N`. Both must go or the physical one still eats the key.
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind
